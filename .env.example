# Created on the first `npm start`. Fill this in, then start again.
# Do not commit `.env`. The resource group is not a setting here.
# The endpoint already names the resource.

# Foundry resource → Keys and Endpoint → Key
AZURE_OPENAI_API_KEY=

# Foundry project endpoint. Keep the /openai/v1 path.
# Foundry: https://YOUR_RESOURCE.services.ai.azure.com/openai/v1
# Classic: https://YOUR_RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/openai/v1

# Hostname only. Same host as the endpoint. No scheme and no path.
AZURE_OPENAI_ALLOW_HOSTS=YOUR_RESOURCE.services.ai.azure.com

# Deployment names from the Foundry project. These are the names you chose
# when you deployed a model. They can differ from the model id.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_DEPLOYMENT_HAIKU=your-deployment-name
AZURE_OPENAI_DEPLOYMENT_SONNET=your-deployment-name
AZURE_OPENAI_DEPLOYMENT_OPUS=your-deployment-name
AZURE_OPENAI_DEPLOYMENT_FABLE=your-deployment-name

# Optional. Defaults are 20000000 tokens per UTC day, and port 8081.
# AZURE_DAILY_TOKEN_CEILING=20000000
# AZURE_PORT=8081
# AZURE_MAX_OUTPUT_TOKENS=128000
# AZURE_REASONING_EFFORT=
